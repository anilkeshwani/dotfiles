# ~/.env — shell-agnostic exported env vars and PATH additions.
# Sourced by both .bashrc and .zshrc.

# Login shells reach this file twice (.zprofile + .zshrc; .profile + .bashrc) — bail on
# the second pass. Deliberately not exported: nested shells must re-source to get nvm's
# shell functions, which don't survive exec.
[ -n "${_DOTFILES_ENV_SOURCED:-}" ] && return 0
_DOTFILES_ENV_SOURCED=1

# Add to PATH only if absent — nested shells inherit PATH, so unconditional edits duplicate
_path_has() { case ":${PATH}:" in *":$1:"*) return 0 ;; *) return 1 ;; esac; }

# User-local binaries
_path_has "${HOME}/.local/bin" || export PATH="$PATH:${HOME}/.local/bin"

# NVM — Node Version Manager
# Sourced here for PATH; machine-specific version pins are in .env_macos / .env_linux
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# Volta — alternative Node version manager (kept alongside NVM for compatibility)
export VOLTA_HOME="$HOME/.volta"
_path_has "$VOLTA_HOME/bin" || export PATH="$VOLTA_HOME/bin:$PATH"

# Go: add compiled binaries to PATH
if command -v go >/dev/null 2>&1; then
    _gobin="$(go env GOPATH)/bin"
    _path_has "$_gobin" || export PATH="$PATH:$_gobin"
    unset _gobin
fi

# opencode — its installer appends a hardcoded absolute PATH export to .zshrc; prefer this
# $HOME-relative version and delete that line after any reinstall.
if [ -d "${HOME}/.opencode/bin" ]; then
    _path_has "${HOME}/.opencode/bin" || export PATH="${HOME}/.opencode/bin:$PATH"
fi

unset -f _path_has

# Dagster — root dir for instance config, logs, and local run storage
export DAGSTER_HOME="$HOME/.dagster_home"

# Claude Code — one config dir per account. CLAUDE_CONFIG_DIR relocates the entire config
# tree, .claude.json included, and that file holds oauthAccount — so a second dir is a
# second login and the subscriptions can run side by side. Bare `claude` keeps the default
# ~/.claude (work); ccp / ccwe in .aliases target the others. Shared config is symlinked
# into every dir by dotfiles/install.py, which reads these vars. Override the paths (or
# leave a var unset to skip provisioning that profile) in .env_linux / .env_macos.
export CLAUDE_CONFIG_DIR_WORK="${CLAUDE_CONFIG_DIR_WORK:-$HOME/.claude}"
export CLAUDE_CONFIG_DIR_PERSONAL="${CLAUDE_CONFIG_DIR_PERSONAL:-$HOME/.claude-personal}"
export CLAUDE_CONFIG_DIR_WORK_EXTRA="${CLAUDE_CONFIG_DIR_WORK_EXTRA:-$HOME/.claude-work-extra}"

# Terminfo for uv-installed Python tools (nvitop, etc.).
# uv ships python-build-standalone, whose bundled ncurses ignores Debian/Ubuntu's
# terminfo locations — so curses TUIs fail with "could not find terminfo database".
if [ "$(uname -s)" = "Linux" ] && [ -z "${TERMINFO_DIRS:-}" ]; then
    export TERMINFO_DIRS="/etc/terminfo:/lib/terminfo:/usr/share/terminfo"
fi

# COLORTERM — makes tools (Claude Code, bat, delta, nvim) emit 24-bit colour rather than
# the 256 they infer from $TERM. Ghostty sets it, but ssh never forwards it: sshd's
# AcceptEnv defaults to "LANG LC_*". The excluded terminals can't render 24-bit escapes.
if [ -z "${COLORTERM:-}" ]; then
    case "${TERM:-dumb}" in
        dumb | linux | vt* | screen | *-16color) ;;
        *) export COLORTERM=truecolor ;;
    esac
fi

# ripgrep — rg reads a config file only when this points at one; there is no
# XDG auto-discovery. Path is literal rather than ${XDG_CONFIG_HOME:-...} so it
# always matches where install.py symlinks the file.
export RIPGREP_CONFIG_PATH="${HOME}/.config/ripgrep/ripgreprc"

# arxivbot (obsidian-import) defaults the vault to ~/Desktop/journal. The vault lives at
# ~/journal on every host, so without this DB_PATH lands in a directory that doesn't
# exist and sqlite reports "unable to open database file".
export OBSIDIAN_VAULT_DIR="$HOME/journal"

#!/usr/bin/env bash

ngclog() {
    local ngc_log_dir="${HOME}/ngc-logs"
    if [ ! -d "$ngc_log_dir" ]; then
        echo "${ngc_log_dir} does not exist"
    else
        local ngc_job_logfile="${ngc_log_dir}/$1.txt"
        ngc batch log "$1" >"$ngc_job_logfile"
        echo "$ngc_job_logfile"
    fi
}

sshkeyadd() {
    local ssh_key_path="${HOME}/.ssh/id_ed25519"
    eval "$(ssh-agent -s)"
    ssh-add "$ssh_key_path"
}

sshkeyaddgh() {
    local ssh_key_path="${HOME}/.ssh/id_ed25519_github"
    eval "$(ssh-agent -s)"
    ssh-add "$ssh_key_path"
}

file_ends_with_newline() {
    [[ $(tail -c1 "$1" | wc -l) -gt 0 ]]
}

git_first_commit_date() {
    if [ $# -eq 0 ]; then
        echo "Usage: git_first_commit <file_path>"
        return 1
    fi

    local file_path="$1"
    if [ ! -f "$file_path" ]; then
        echo "Error: File not found: $file_path"
        return 1
    fi

    local first_commit iso_date
    first_commit=$(git log --reverse --date=format:"%a %b %d %T %Y %z" --pretty=format:"%ad" -- "$file_path" 2>/dev/null | head -1)
    iso_date=$(git log --reverse --date=iso8601-strict --pretty=format:"%ad" -- "$file_path" 2>/dev/null | head -1)

    if [ -z "$first_commit" ]; then
        echo "Error: No commit history found for $file_path"
        return 1
    fi

    echo "First commit date for ${file_path}: ${first_commit} (${iso_date})"
}

# This dotfiles repo is public, but Claude Code's autoMode block — org name, source
# control, internal services, sensitive data locations — is read only from the user
# settings file, managed settings, or --settings, never from project settings. So it
# lives in an untracked settings.private.json inside the config dir and is layered in
# here. Ours goes first so an explicit --settings on the command line still wins: the
# last flag wins and repeating it replaces rather than merges.
claude() {
    local private_settings="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/settings.private.json"
    if [ ! -r "$private_settings" ]; then
        echo "claude: ${private_settings} not found; running without the autoMode org context" >&2
        command claude "$@"
        return
    fi
    command claude --settings "$private_settings" "$@"
}

claude_with_config_dir() {
    local config_dir="$1"
    shift
    if [ -z "$config_dir" ]; then
        echo "claude_with_config_dir: no config dir given; is the CLAUDE_CONFIG_DIR_* var set?" >&2
        return 2
    fi
    if [ ! -d "$config_dir" ]; then
        echo "claude_with_config_dir: ${config_dir} not found; run 'uv run --script ${HOME}/dotfiles/install.py'" >&2
        return 1
    fi
    # The export inside the subshell puts CLAUDE_CONFIG_DIR into claude's own
    # environment, so everything it spawns — hooks, the daemon, subagents — resolves the
    # same account, without leaking the var into this shell. Calling the claude function
    # rather than the binary picks up that account's settings.private.json.
    (export CLAUDE_CONFIG_DIR="$config_dir"; claude "$@")
}

claude-personal() { claude_with_config_dir "${CLAUDE_CONFIG_DIR_PERSONAL}" "$@"; }

claude-work-extra() { claude_with_config_dir "${CLAUDE_CONFIG_DIR_WORK_EXTRA}" "$@"; }

set-gpu() {
    if [ -z "$1" ]; then
        echo "Enter the GPU ID(s) comma-separated for multiple GPUs, e.g., 0,1:"
        read -r gpu_ids
    else
        gpu_ids="$1"
    fi
    export CUDA_VISIBLE_DEVICES=$gpu_ids
    echo "CUDA_VISIBLE_DEVICES set to: $CUDA_VISIBLE_DEVICES"
}

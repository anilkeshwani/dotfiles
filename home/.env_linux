# ~/.env_linux — Linux-specific env, sourced from .bashrc/.zshrc on Linux.

# Homebrew — ensure /home/linuxbrew/.linuxbrew/bin is on PATH for non-login shells.
# HOMEBREW_PREFIX is exported by shellenv, so skip when a login shell already ran it
# (.profile_linux) — rerunning duplicates the PATH entries.
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ] && [ -z "${HOMEBREW_PREFIX:-}" ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# GCP: Linux dev servers outside Google (e.g. bigboss) authenticate SkyPilot and the
# Google client libraries as the skypilot-v1 service account. The key comes from
# Bitwarden ("gcp neural nexus skypilot service account") and is never tracked here.
# Guarded on the file so hosts without the key keep their own gcloud login.
# The SkyPilot API server reads this only at startup: `sky api stop` after changes.
if [ -f "${HOME}/.config/gcloud/keys/skypilot-v1.json" ]; then
    export GOOGLE_APPLICATION_CREDENTIALS="${HOME}/.config/gcloud/keys/skypilot-v1.json"
fi
